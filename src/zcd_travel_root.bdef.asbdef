projection;
strict ( 2 );
use draft;
use side effects;

define behavior for zcd_travel_root //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action DeductDiscount;
  use action AcceptTravel;
  use action RejectTravel;
  use association _book { create; with draft; }
  use action Activate;
  use action Edit;
  use action Prepare;
  use action Resume;
  use action Discard;
}


define behavior for zcd_booking_child //alias <alias_name>
{

  use update;
  use delete;
  use association _travel { with draft; }
  use association _supply { create; with draft; }
}
define behavior for zcd_supplement_child
{
  use association _travel { with draft; }
  use association _booking { with draft; }
  use delete;
  use update;

}