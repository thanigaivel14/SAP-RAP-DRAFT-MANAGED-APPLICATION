@Metadata.layer: #CORE
annotate entity zcd_supplement_child with
{
@UI.facet: [
     { id :'Supply',
     purpose: #STANDARD,
     type: #IDENTIFICATION_REFERENCE,
     label: 'Supplyment',
        position: 10
      }
   ]
  @UI.lineItem:       [ { position: 10, label: 'Booking Supplement ID' } ]
  @UI.identification: [ { position: 10, label: 'Booking Supplement ID' } ]
  BookingSupplementId;

  @UI.lineItem:       [ { position: 20, label: 'Supplement ID' } ]
  @UI.identification: [ { position: 20, label: 'Supplement ID' } ]
  SupplementId;

  @UI.lineItem:       [ { position: 30, label: 'Price' } ]
  @UI.identification: [ { position: 30, label: 'Price' } ]
  Price;

  @UI.lineItem:       [ { position: 40, label: 'Currency' } ]
  @UI.identification: [ { position: 40, label: 'Currency' } ]
  CurrencyCode;


  /* Technical fields - normally hidden from UI */

  @UI.hidden: true
  BooksupplUuid;

  @UI.hidden: true
  RootUuid;

  @UI.hidden: true
  ParentUuid;

  @UI.hidden: true
  LocalLastChangedAt;

}