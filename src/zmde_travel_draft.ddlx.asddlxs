@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Travel',
    typeNamePlural: 'Travels',
    title: {
      type: #STANDARD,
      value: 'TravelId'
    },
    description: {
      type: #STANDARD,
      value: 'Description'
    }
  }
}
annotate view zcd_travel_root with
{
  @UI.facet: [
    {
      id: 'Travel',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Travel Details',
      position: 10
    },
    { id :'Booking',
    purpose: #STANDARD,
    type: #LINEITEM_REFERENCE,
    label: 'Booking',
    targetElement: '_book',
    position: 20
     }
  ]

  @UI.lineItem: [
    { position: 10, label: 'Travel ID' },{ type: #FOR_ACTION , dataAction: 'DeductDiscount' , label: 'Discount '  },
    { type: #FOR_ACTION , dataAction: 'AcceptTravel' , label: 'Accept '  },
     { type: #FOR_ACTION , dataAction: 'RejectTravel' , label: 'Reject '  }
  ]
  @UI.identification: [
    { position: 10, label: 'Travel ID' },{ type: #FOR_ACTION , dataAction: 'DeductDiscount' , label: 'Discount '  },
    { type: #FOR_ACTION , dataAction: 'AcceptTravel' , label: 'Accept '  },
     { type: #FOR_ACTION , dataAction: 'RejectTravel' , label: 'Reject '  }
  ]
  @UI.selectionField: [{  position: 10 }]

  TravelId;

  @UI.lineItem: [
    { position: 20, label: 'Agency' }
  ]
  @UI.identification: [
    { position: 20, label: 'Agency' }
  ]
  AgencyId;

  @UI.lineItem: [
    { position: 30, label: 'Customer' }
  ]
  @UI.identification: [
    { position: 30, label: 'Customer' }
  ]
  
  CustomerId;

  @UI.lineItem: [
    { position: 40, label: 'Begin Date' }
  ]
  @UI.identification: [
    { position: 40, label: 'Begin Date' }
  ]
  BeginDate;

  @UI.lineItem: [
    { position: 50, label: 'End Date' }
  ]
  @UI.identification: [
    { position: 50, label: 'End Date' }
  ]
  EndDate;

  @UI.identification: [
    { position: 60, label: 'Booking Fee' }
  ]
  BookingFee;

  @UI.lineItem: [
    { position: 60, label: 'Total Price' }
  ]
  @UI.identification: [
    { position: 70, label: 'Total Price' }
  ]
  TotalPrice;

  @UI.identification: [
    { position: 80, label: 'Currency' }
  ]
  CurrencyCode;

  @UI.identification: [
    { position: 90, label: 'Description' }
  ]
  Description;

  @UI.lineItem: [
    { position: 70, label: 'Status' }
  ]
  @UI.identification: [
    { position: 100, label: 'Status' }
  ]
  overallStatusText;
  @UI.hidden: true
  TravelUuid;

  @UI.hidden: true
  LocalCreatedBy;

  @UI.hidden: true
  LocalCreatedAt;

  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}