managed;

strict ( 2 );
with draft;
define behavior for ZR_TRAVELapp_D //alias <alias_name>
implementation in class zbp_r_travelapp_d unique
persistent table /dmo/a_travel_d
draft table zdr_travel_draft
lock master
total etag LastChangedAt
authorization master ( instance, global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  action ( authorization : update, features : instance ) AcceptTravel result [1] $self;
  action ( authorization : update, features : instance ) RejectTravel result [1] $self;
  action ( authorization : update, features : instance ) DeductDiscount parameter ZA_DEDUCT_DISCOUNT result [1] $self;
  internal action RecalTotal;
  determination SetTravel on save { create; }
  determination SetStatus on modify { create; update; }
  determination TotalPrice on modify { update; field BookingFee; }
  field ( mandatory ) CustomerId;
  validation CustomerIdValidation on save { create; }

  side effects { field BookingFee affects field TotalPrice; }
  field ( numbering : managed, readonly ) TravelUuid;
  field ( readonly ) TravelId, OverallStatus,TotalPrice,LastChangedAt,LocalLastChangedAt;

  association _book { create ( authorization : update ); with draft; }
  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare

  {
    validation CustomerIdValidation;
    validation zr_bookingapp_dra~valcustomerId;
    validation zr_bookingSuppl_d~SupplementId;


  }


  mapping for /dmo/a_travel_d
    {
      AgencyId           = agency_id;
      BeginDate          = begin_date;
      BookingFee         = booking_fee;
      CurrencyCode       = currency_code;
      CustomerId         = customer_id;
      Description        = description;
      EndDate            = end_date;
      LastChangedAt      = last_changed_at;
      LocalCreatedAt     = local_created_at;
      LocalCreatedBy     = local_created_by;
      LocalLastChangedAt = local_last_changed_at;
      LocalLastChangedBy = local_last_changed_by;
      OverallStatus      = overall_status;
      TotalPrice         = total_price;
      TravelId           = travel_id;
      TravelUuid         = travel_uuid;
    }
}

define behavior for zr_bookingapp_dra //alias <alias_name>
implementation in class zbd_r_booking1_d unique
persistent table /dmo/a_booking_d
draft table zdr_book_draft
lock dependent by _travel
authorization dependent by _travel
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( numbering : managed, readonly ) BookingUuid;
  determination SetBookingId on save { create; }
  determination SetBookingDate on save { create; }
  determination CalculateTotalPrice on modify { create; field FlightPrice, CurrencyCode; }
  side effects
  { field FlightPrice affects entity _travel;
    field CurrencyCode affects entity _travel; }

  field ( mandatory ) CustomerId;
  validation valcustomerId on save { create; }
  field ( readonly ) ParentUuid, BookingId, BookingDate;
  association _travel { with draft; }
  association _supply { create ( authorization : update ); with draft; }
  mapping for /dmo/a_booking_d
    {
      BookingUuid        = booking_uuid;
      ParentUuid         = parent_uuid;
      BookingId          = booking_id;
      BookingDate        = booking_date;
      CustomerId         = customer_id;
      CarrierId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      FlightPrice        = flight_price;
      CurrencyCode       = currency_code;
      BookingStatus      = booking_status;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for zr_bookingSuppl_d //alias <alias_name>
implementation in class zbd_r_supply unique
persistent table /dmo/a_bksuppl_d
draft table zdr_supply_draft
lock dependent by _travel
authorization dependent by _travel
//etag master <field_name>
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( numbering : managed, readonly ) BooksupplUuid;
  field ( readonly ) ParentUuid, RootUuid;
  association _travel { with draft; }
  association _booking { with draft; }
  validation SupplementId on save { create; }
  field ( mandatory ) SupplementId;
  mapping for /dmo/a_bksuppl_d
    {
      BooksupplUuid       = booksuppl_uuid;
      RootUuid            = root_uuid;
      ParentUuid          = parent_uuid;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LocalLastChangedAt  = local_last_changed_at;
    }
}